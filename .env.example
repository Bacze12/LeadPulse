# ====== Auth.js ======
# Genera una con: openssl rand -base64 32
AUTH_SECRET=""

# URL de la app (requerida por Auth.js en producciÃ³n)
# AUTH_URL="http://localhost:3000"

# ====== IntegraciÃ³n con n8n ======
# Webhook que recibe eventos del CRM (para n8n "Webhook node" en n8n)
# Ej: https://TU-n8n.app.n8n.cloud/webhook/crm
N8N_WEBHOOK_URL=""
# Clave que se envÃ­a en el header "x-webhook-secret" (opcional)
